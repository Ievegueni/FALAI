# Core
DATABASE_URL=postgresql://falai:password@localhost:5432/falai
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-min-32-chars-long-secret
ENCRYPTION_KEY=change-me-must-be-exactly-32-chars

# Yeastar P-Series Cloud (migra para SystemSetting após bootstrap)
YEASTAR_BASE_URL=https://your-pbx.yeastar.cloud
YEASTAR_CLIENT_ID=
YEASTAR_CLIENT_SECRET=

# Yeastar stub mode: não faz chamadas reais (para desenvolvimento sem PBX)
YEASTAR_STUB_MODE=true

# STT
DEEPGRAM_API_KEY=

# LLM
ANTHROPIC_API_KEY=

# TTS
ELEVENLABS_API_KEY=
AZURE_TTS_KEY=
AZURE_TTS_REGION=

# Pagamentos
PROXYPAY_API_KEY=

# SMS
FUTURIX_SMS_API_KEY=

# API
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
# Proxies em que confiamos para nos dizer o IP de origem (IP ou CIDR, separados
# por vírgula). Vazio = usar o IP do socket. Em produção atrás de nginx, pôr o
# IP do nginx — é o que faz a allowlist de IP das chaves de API funcionar.
TRUSTED_PROXIES=

# Motor SIP próprio (Asterisk) — ver infra/asterisk/README.md
# AMI = estado e recarregamento da configuração; ARI = controlo das chamadas.
ASTERISK_AMI_URL=http://127.0.0.1:8088
ASTERISK_AMI_USER=falai
ASTERISK_AMI_PASSWORD=
ASTERISK_GENERATED_DIR=
TELEPHONY_ENGINE=
ASTERISK_ARI_URL=http://127.0.0.1:8088
ASTERISK_ARI_USER=falai
ASTERISK_ARI_PASSWORD=

# Formato em que os números são entregues à ANGOVOIP. A confirmar com eles;
# muda-se aqui sem tocar no código.
#   national -> 912345678      (por omissão)
#   cc       -> 244912345678
#   e164     -> +244912345678
ASTERISK_DIAL_FORMAT=national

# Número a apresentar nas chamadas de saída. Vazio = usa o utilizador do trunk
# activo, que é o que a ANGOVOIP reconhece por omissão.
ASTERISK_CALLER_ID=

# Webphone (WebRTC) no CRM — o nginx do host faz proxy de PUBLIC_WEBPHONE_WSS_URL
# para o Asterisk (ver DEPLOY.md secção 8 e infra/asterisk/docker-compose.yml).
PUBLIC_WEBPHONE_WSS_URL=wss://crm.teu-dominio.com/webphone-ws
PUBLIC_WEBPHONE_SIP_DOMAIN=crm.teu-dominio.com
