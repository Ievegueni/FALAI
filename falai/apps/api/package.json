{
  "name": "@falai/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsup src/index.ts --format esm --dts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "otp:prompts": "tsx --env-file=../../.env scripts/setup-otp-prompts.mts",
    "test": "vitest run"
  },
  "dependencies": {
    "@falai/db": "workspace:*",
    "@falai/providers": "workspace:*",
    "@falai/shared": "workspace:*",
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/websocket": "^11.3.0",
    "argon2": "^0.40.0",
    "bullmq": "^5.80.2",
    "csv-parse": "^7.0.1",
    "fastify": "^5.10.0",
    "fastify-plugin": "^6.0.0",
    "fastify-raw-body": "^5.0.0",
    "ioredis": "^5.4.0",
    "otplib": "^12.0.1",
    "pino": "^9.3.0",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "xlsx": "^0.18.5",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "tsup": "^8.2.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
