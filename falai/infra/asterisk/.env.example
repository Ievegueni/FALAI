# Copiar para infra/asterisk/.env e preencher.
# O .env está no .gitignore — NUNCA colocar segredos neste ficheiro de exemplo,
# porque o repositório é público.



# ─── NAT ─────────────────────────────────────────────────────────────────────
# Deixar VAZIO no servidor com IP público directo.
# Em casa/escritório atrás de router, pôr aqui o IP público (curl ifconfig.me)
# para o Asterisk o anunciar no SDP. Ajuda, mas não resolve tudo — ver README.
EXTERNAL_IP=

# ─── RTP ─────────────────────────────────────────────────────────────────────
RTP_START=10000
RTP_END=10100

# Endereço que o Asterisk ANUNCIA nos candidatos ICE do webphone (WebRTC).
# Dentro do Docker ele só conhece o IP interno do container, que o browser não
# alcança — sem isto o ICE falha e a chamada estabelece SEM ÁUDIO.
# Tem de ser o IP onde as portas RTP_START-RTP_END estão publicadas:
#   dev macOS  -> IP do Mac na LAN (ex.: 192.168.1.75)
#   produção   -> IP público do servidor
# Se ficar vazio, usa-se o EXTERNAL_IP.
WEBRTC_MEDIA_ADDRESS=

# ─── Webphone (WebRTC) ───────────────────────────────────────────────────────
# Porta interna (só 127.0.0.1) da sinalização WS do webphone. O TLS é feito
# pelo nginx do host, que faz proxy de wss://<dominio>/webphone-ws para aqui.
WS_PORT=8089

# ─── Interface de gestão (AMI para estado, ARI para controlo) ────────────────
# Usadas pela API do Falaí. Gerar passwords fortes — dão acesso ao motor.
AMI_USER=falai
AMI_PASSWORD=
ARI_USER=falai
ARI_PASSWORD=

# ─── Base de dados do Falaí ─────────────────────────────────────────────────
# O motor lê daqui trunks e extensões (PJSIP Realtime). Já não há credenciais
# de trunk neste ficheiro: vivem na base de dados, encriptadas, e editam-se no
# backoffice.
DB_HOST=host.docker.internal
DB_PORT=5435
DB_NAME=falai
DB_USER=falai
DB_PASSWORD=

# CDR das chamadas marcadas no telefone (webphone/hardphone) → API do Falaí.
# O segredo TEM de ser igual ao ASTERISK_CDR_SECRET do .env da API.
# Em produção (API e Asterisk no mesmo servidor): http://127.0.0.1:3000/...
FALAI_CDR_URL=http://host.docker.internal:3000/webhooks/asterisk/cdr
FALAI_CDR_SECRET=
