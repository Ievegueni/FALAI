# Copiar para infra/asterisk/.env e preencher.
# O .env está no .gitignore — NUNCA colocar segredos neste ficheiro de exemplo,
# porque o repositório é público.



# ─── NAT ─────────────────────────────────────────────────────────────────────
# Deixar VAZIO no servidor com IP público directo.
# Em casa/escritório atrás de router, pôr aqui o IP público (curl ifconfig.me)
# para o Asterisk o anunciar no SDP. Ajuda, mas não resolve tudo — ver README.
EXTERNAL_IP=

# ─── RTP ─────────────────────────────────────────────────────────────────────
RTP_START=10000
RTP_END=10100

# ─── Webphone (WebRTC) ───────────────────────────────────────────────────────
# Porta interna (só 127.0.0.1) da sinalização WS do webphone. O TLS é feito
# pelo nginx do host, que faz proxy de wss://<dominio>/webphone-ws para aqui.
WS_PORT=8089

# ─── Interface de gestão (AMI para estado, ARI para controlo) ────────────────
# Usadas pela API do Falaí. Gerar passwords fortes — dão acesso ao motor.
AMI_USER=falai
AMI_PASSWORD=
ARI_USER=falai
ARI_PASSWORD=

# ─── Base de dados do Falaí ─────────────────────────────────────────────────
# O motor lê daqui trunks e extensões (PJSIP Realtime). Já não há credenciais
# de trunk neste ficheiro: vivem na base de dados, encriptadas, e editam-se no
# backoffice.
DB_HOST=host.docker.internal
DB_PORT=5435
DB_NAME=falai
DB_USER=falai
DB_PASSWORD=
