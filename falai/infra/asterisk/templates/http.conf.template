;===============================================================================
; Servidor HTTP interno do Asterisk — serve o AMI (estado) e o ARI (controlo).
;
; SEGURANÇA: esta porta NUNCA deve ser exposta à internet. No servidor
; definitivo, restringir ao IP da API do Falaí ou usar rede interna do Docker.
; Ver docs/PLANO-INDEPENDENCIA-PBX.txt §16.4.
;===============================================================================
[general]
enabled=yes
; 25/08/2026: era 0.0.0.0 e o ARI (controlo total da central) estava exposto
; à internet, só com a senha à frente. A API e o proxy WSS do nginx falam com
; isto pelo laço local, portanto não há razão para escutar mais longe.
bindaddr=127.0.0.1
bindport=8088
prefix=
enablestatic=no
