generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // pg_trgm: pesquisa de clientes por parte do nome/número com índice (melhoria 5)
  extensions = [pg_trgm]
}

// ============ ENUMS ============

enum ProductType {
  VOICE_AI // Operador: PBX + IA da plataforma, faturado por minuto
  CRM_BYO_PBX // Só CRM: o cliente liga o PBX Yeastar dele (bring-your-own-PBX)
  API_BYOM // Só API: o cliente tem o CRM e o modelo dele; nós damos voz, orquestração e controlo
}

// Motor que transporta as chamadas deste tenant. Os dois coexistem durante a
// migração para o PBX nativo — ver docs/PLANO-INDEPENDENCIA-PBX.txt §15.
enum TelephonyEngine {
  YEASTAR // PBX externo (a sair). Valor por omissão enquanto durar a migração.
  ASTERISK // Motor próprio do Falaí, trunk directo à operadora.
}

enum BillingMode {
  PER_MINUTE // ceil(segundos/60) × pricePerMinuteCents (arredonda ao minuto)
  PER_SECOND // segundos × pricePerMinuteCents/60 (ao segundo exacto)
  PER_CALL // pricePerCallCents por chamada, independente da duração (ex.: OTP)
}

// Módulo PBX nativo (Extensões/Trunk) — ver docs/sip_trunk.md
enum TrunkType {
  REGISTER // Trunk de registo (o Falaí regista-se no provider com user/secret)
  PEER // Trunk peer (IP-to-IP, sem registo)
}

enum SipTransport {
  UDP
  TCP
  TLS
}

enum InvoiceStatus {
  PAID
  DUE
  VOID
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CLOSED
}

enum TenantRole {
  OWNER
  ADMIN
  MANAGER // gestor operacional: toda a operação, sem configuração técnica (ver services/userScope.ts)
  SUPERVISOR // supervisão em tempo real dos grupos que lhe são atribuídos (melhoria 4)
  MEMBER
  VIEWER
}

enum AdminRole {
  SUPERADMIN
  OPERATOR
  FINANCE
  SUPPORT
}

enum AgentStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  PAUSED
  BLOCKED
}

enum CallStatus {
  QUEUED
  DIALING
  RINGING
  IN_PROGRESS
  COMPLETED
  NO_ANSWER
  BUSY
  FAILED
  CANCELLED
  ESCALATED
}

enum CallKind {
  AI_AGENT // chamada conduzida por agente de IA
  DIRECT // click-to-call (extensão → número), sem IA
  OTP // entrega de código OTP por voz, sem IA
  INBOUND // chamada recebida (entrada), registada ao vivo a partir do PBX
  FIXED_SCRIPT // campanha com script pré-definido, sem IA
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  DONE
  CANCELLED
}

enum CampaignMode {
  VOICE_AI
  FIXED_SCRIPT
}

enum TurnRole {
  AGENT
  HUMAN
  SYSTEM
}

enum TxType {
  TOPUP
  CALL_CHARGE
  SMS_CHARGE
  TEXT_CHARGE // respostas da IA nos canais de texto
  REFUND
  ADJUSTMENT
  MONTHLY_FEE
}

enum SmsStatus {
  QUEUED // aceite pela plataforma, a caminho do gateway
  SENT // entregue ao gateway (Futurix)
  DELIVERED // confirmado entregue ao destinatário (delivery report)
  FAILED // falhou no envio ou entrega
}

enum CampaignContactStatus {
  PENDING
  QUEUED
  IN_PROGRESS
  COMPLETED
  FAILED
  OPTED_OUT
  // Nunca chegou a ser marcado: a campanha foi cancelada ou o contacto foi
  // retirado. Distinto de FAILED, que é uma tentativa real que correu mal —
  // sem esta distinção o cancelamento inflacionava a taxa de insucesso.
  SKIPPED
}

// ============ TENANTS & ACESSO ============

model Tenant {
  id                   String              @id @default(cuid())
  name                 String
  // Logo do cliente mostrado no CRM (data URL, ≤ 256 KB). Null = logo da Comunica.
  logoDataUrl          String?             @db.Text
  nif                  String?             @unique
  email                String
  phone                String
  status               TenantStatus        @default(TRIAL)
  plan                 Plan                @relation(fields: [planId], references: [id])
  planId               String
  balanceCents         Int                 @default(0)
  // Música de espera carregada (sounds/moh/<id>/hold.wav): toca a quem liga
  // enquanto a extensão toca. false = sinal de chamada.
  holdAudio            Boolean             @default(false)
  creditLimitCents     Int                 @default(0)
  webhookUrl           String?
  webhookSecret        String?
  maxConcurrent        Int                 @default(1)
  // Overrides de funcionalidades por tenant (Json { agents, campaigns, contacts, ... }).
  // Sobrepõe-se aos defaults e às capacidades do plano; ver services/features.ts
  features             Json?
  // Override do modo de cobrança do plano (null = usa o do plano)
  billingModeOverride  BillingMode?
  // Preço por minuto próprio do cliente, em cêntimos (null = usa o do plano).
  // Vale para PER_MINUTE e PER_SECOND; ver effectivePrice em billing.service.
  pricePerMinuteOverrideCents Int?
  // Gravação das chamadas deste cliente. Desligado por defeito de propósito:
  // gravar sem o cliente ter pedido é uma decisão que não nos compete tomar.
  recordCalls          Boolean             @default(false)
  // Toca o aviso de que a chamada vai ser gravada, assim que alguém atende.
  // Separado de recordCalls porque nem todos os clientes precisam do aviso —
  // e quem precisa não pode depender de se lembrar de o ligar à parte.
  recordingAnnounce    Boolean             @default(false)
  lines                TenantLine[]
  // Motor de telefonia deste cliente. Permite migrar tenant a tenant para o
  // motor próprio (Asterisk) e reverter mudando só este campo, sem redeploy.
  // Ver docs/PLANO-INDEPENDENCIA-PBX.txt §15.2.
  telephonyEngine      TelephonyEngine     @default(YEASTAR)
  // PBX próprio do cliente (bring-your-own-PBX) — só usado quando plan.productType = CRM_BYO_PBX
  pbxBaseUrl           String?
  pbxClientId          String?
  pbxClientSecret      String? // encriptado (AES-256-GCM) via crypto.service
  pbxExtension         String? // extensão de saída por defeito
  pbxConnected         Boolean             @default(false) // resultado do último teste de ligação
  pbxLastSyncAt        DateTime? // último sync de CDR do PBX do cliente
  pbxWebhookToken      String?             @unique // token do URL de webhook do PBX do cliente
  pbxCalls             PbxCall[]
  // SMS (gateway Futurix) — credenciais e preço configurados por tenant no backoffice
  smsApiKey            String? // encriptado (AES-256-GCM) via crypto.service
  smsSenderId          String? // remetente (alfanumérico) atribuído ao cliente
  smsPriceSegmentCents Int? // preço por segmento (definido no backoffice; null = usa o do plano)
  // SMS automático a quem ficou sem resposta. Desligado por defeito: cada SMS
  // destes é cobrado ao cliente, por isso ligar-se sozinho seria cobrar-lhe algo
  // que ele não pediu.
  missedCallSms        Boolean             @default(false)
  missedCallSmsText    String? // template da mensagem; aceita {numero} e {empresa}
  smsMessages          SmsMessage[]
  smsCampaigns         SmsCampaign[]
  nextBillingAt        DateTime? // data do próximo débito da subscrição mensal
  invoices             Invoice[]
  deletedAt            DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  apiKeys              ApiKey[]
  users                TenantUser[]
  accessProfiles       AccessProfile[]
  // Análise dos relatórios com IA (melhoria 6)
  aiReportDailyLimit   Int              @default(20) // análises novas por dia (definido no backoffice)
  aiReportAgentNames   Boolean          @default(false) // enviar à IA o nome dos agentes (senão, só a extensão)
  reportAnalyses       ReportAnalysis[]
  agents               Agent[]
  models               TenantModel[]
  calls                Call[]
  campaigns            Campaign[]
  transactions         WalletTransaction[]
  contacts             Contact[]
  // Módulo PBX nativo (Extensões/Trunk) — ver docs/sip_trunk.md
  extensions           Extension[]
  trunks               Trunk[]
  extensionGroups      ExtensionGroup[]
  roles                Role[]
  outboundRoutes       OutboundRoute[]
  inboundRoutes        InboundRoute[]
  ivrMenus             IvrMenu[]
  // Canais de texto — ver docs/PLANO-CANAIS-TEXTO.md
  inboxes              Inbox[]
  conversations        Conversation[]
  cannedResponses      CannedResponse[]
  // Relatórios de atendimento — ver CallLeg
  callLegs             CallLeg[]
  rejectReasons        RejectReason[]
  // Tipificação de chamadas (melhoria 2): obrigatória ou não, e quanto tempo o
  // agente fica indisponível à espera de tipificar antes de contar como "não tipificada".
  callCategories       CallCategory[]
  typingRequired       Boolean             @default(false)
  typingMaxSecs        Int                 @default(60)
  // Supervisão (melhoria 4): avisar o agente em modo Escuta (Sussurro e
  // Intervenção avisam sempre) e aviso ao cliente de que a chamada pode ser
  // monitorizada (Lei 22/11) — áudio custom/monitor_<tenantId>.
  supervisionNotifyListen Boolean          @default(false)
  monitoringNotice     Boolean             @default(false)
  supervisionEvents    SupervisionEvent[]
  // Tickets — ver docs/PLANO-CENTRO-ATENDIMENTO.md. ticketSeq dá o número
  // sequencial do próximo ticket (incremento atómico, sem corrida).
  ticketSeq            Int                 @default(0)
  tickets              Ticket[]
  // Metas e limites de alerta (fase 4): { slaThresholdSecs, slaTargetPct,
  // maxWaitSecs, maxHandleSecs, minAvailableAgents, maxAbandonPct, maxTmaSecs }.
  // Validado em services/alerts.service.ts. Null = sem alertas.
  serviceTargets       Json?
  alerts               Alert[]
}

// Linha de chamadas de um cliente. Cada tenant pode ter uma ou mais linhas
// (extensão / DID). A linha marcada como isDefault é usada em chamadas sem
// extensão explícita. isActive permite desligar uma linha sem a apagar.
model TenantLine {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name        String // rótulo legível, ex: "Vendas", "Suporte"
  extension   String // extensão no PBX (origem da chamada)
  phoneNumber String? // DID / número público associado, se aplicável
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
}

// ============ MÓDULO PBX NATIVO (Extensões/Trunk) ============
// Falaí é dono da configuração (igual ao Yeastar). Do provider só entram os
// dados de ligação SIP guardados em Trunk. Spec: docs/sip_trunk.md

// Trunk SIP para o provider (saída/entrada). tenantId=null => partilhado do
// operador (produto VOICE_AI, só backoffice edita). tenantId preenchido =>
// BYO por tenant (CRM_BYO_PBX, cliente edita). Ver regra em docs/sip_trunk.md §1.1
model Trunk {
  id                String          @id @default(cuid())
  tenantId          String?
  tenant            Tenant?         @relation(fields: [tenantId], references: [id])
  name              String // ex: "TESTE.ANGOLA.AGV"
  enabled           Boolean         @default(true)
  itspTemplate      String          @default("GENERIC") // "Geral"
  type              TrunkType       @default(REGISTER)
  // Ligação (dados do provider)
  transport         SipTransport    @default(UDP)
  host              String // "87.238.224.117"
  port              Int             @default(5060)
  domain            String? // "87.238.224.117"
  authUser          String // "878029113001" (Nome de utilizador)
  authName          String? // "878029113001" (Nome de autenticação)
  authSecret        String // encriptado (AES-256-GCM) via crypto.service
  outboundProxy     String?
  // Avançadas
  codecs            String[] // ordenado: ["ulaw","alaw","g729","g726","g722","gsm"]
  dtmfMode          String          @default("RFC4733")
  dtmfFmtp          String          @default("0-16")
  authErrorCodes    String          @default("401;407;403")
  authRegAttempts   Int             @default(3)
  regRetryIntervalS Int             @default(20)
  callRestriction   String          @default("OUTBOUND") // Chamada de saída
  maxConcurrent     Int? // null = Ilimitado
  voipFlags         Json? // { qualify, srtp, t38, inbandProgress, ... }
  sipHeaders        Json? // { inbound, outbound, other }
  dids              TrunkDid[]
  inboundRoutes     InboundRoute[]
  outboundRoutes    OutboundRoute[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([tenantId])
}

model TrunkDid {
  id      String  @id @default(cuid())
  trunkId String
  trunk   Trunk   @relation(fields: [trunkId], references: [id], onDelete: Cascade)
  did     String // "244959100354"
  name    String?

  @@unique([trunkId, did])
}

// Extensão configurada nativamente no Falaí (substitui TenantLine na Fase 3).
// sipAuthUser/sipAuthSecret são as credenciais com que um softphone/webphone se
// regista. As restantes abas do Yeastar ficam em JSON por aba.
model Extension {
  id             String                    @id @default(cuid())
  tenantId       String
  tenant         Tenant                    @relation(fields: [tenantId], references: [id])
  number         String // "1000"
  callerId       String // ID de chamador exibido
  displayName    String?
  email          String?
  mobile         String?
  roleId         String?
  role           Role?                     @relation(fields: [roleId], references: [id])
  // Registo SIP
  sipAuthUser    String                    @unique // "Nome de registo", ex "7jyXTI2S56"
  sipAuthSecret  String // encriptado (AES-256-GCM)
  maxIpRegs      Int                       @default(4)
  maxWebRegs     Int                       @default(3)
  // Config por aba (JSON)
  presence       Json? // { forwarding, ringStrategy, ringTimeoutS:30 }
  voicemail      Json? // { enabled, pinAuth, emailNotify, greeting }
  features       Json? // { recording, moh, businessHours:{tz:"WAT"}, monitored }
  voip           Json? // { dtmf, transport, qualify, t38, srtp }
  security       Json? // { disallowIntl:true, ipRestriction, sipAgentAuth }
  isActive       Boolean                   @default(true)
  isDefault      Boolean                   @default(false)
  phoneNumber    String? // DID público associado
  groups         ExtensionGroupMember[]
  outboundRoutes OutboundRoutePermission[]
  callLegs       CallLeg[]
  // Pausa do agente (melhoria 4): em pausa não recebe chamadas de entrada.
  pausedAt       DateTime?
  users          TenantUser[]
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@unique([tenantId, number])
  @@index([tenantId])
}

model ExtensionGroup {
  id          String                 @id @default(cuid())
  tenantId    String
  tenant      Tenant                 @relation(fields: [tenantId], references: [id])
  name        String // "VENDAS", "SUPORTE", "Default_All_Extensions"
  isDefault   Boolean                @default(false)
  permissions Json? // painel de operações (redirecionar, transferir, monitorizar, ...)
  members     ExtensionGroupMember[]
  calls       Call[]
  callLegs    CallLeg[]
  categories  CallCategoryGroup[]
  supervisors SupervisorGroup[]
  tickets     Ticket[]

  @@unique([tenantId, name])
}

model ExtensionGroupMember {
  extensionId String
  groupId     String
  extension   Extension      @relation(fields: [extensionId], references: [id], onDelete: Cascade)
  group       ExtensionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([extensionId, groupId])
}

model Role {
  id          String      @id @default(cuid())
  tenantId    String
  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  name        String // Administrator, Supervisor, Operator, Employee, ...
  permissions Json // matriz por módulo — ver docs/sip_trunk.md §4
  extensions  Extension[]

  @@unique([tenantId, name])
}

// Encaminhamento de saída: que extensões podem usar que trunk, com que caller id
model OutboundRoute {
  id          String                    @id @default(cuid())
  tenantId    String
  tenant      Tenant                    @relation(fields: [tenantId], references: [id])
  name        String // "Default_Outbound_Route", "SHARE_AGV_OUT", "To_S50"
  trunkId     String
  trunk       Trunk                     @relation(fields: [trunkId], references: [id])
  dialPattern String? // prefixo/regex de números permitidos
  callerId    String?
  priority    Int                       @default(0)
  permissions OutboundRoutePermission[]

  @@unique([tenantId, name])
}

model OutboundRoutePermission {
  routeId     String
  extensionId String
  route       OutboundRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  extension   Extension     @relation(fields: [extensionId], references: [id], onDelete: Cascade)

  @@id([routeId, extensionId])
}

// Encaminhamento de entrada: DID → destino (extensão, grupo, IVR, agente IA)
model InboundRoute {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  name       String
  trunkId    String
  trunk      Trunk    @relation(fields: [trunkId], references: [id])
  didPattern String // "244959100354"
  destType   String // EXTENSION | GROUP | IVR | AI_AGENT
  destValue  String // número da extensão / id do grupo / id do agente
  createdAt  DateTime @default(now())

  @@index([tenantId])
}

// Menu de voz (IVR): toca a saudação e encaminha pelo dígito premido.
// O áudio é gerado por TTS ao gravar e fica no Asterisk como custom/ivr_<id>.
model IvrMenu {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name        String
  greeting    String // texto lido ao chamador (TTS), ou descrição se greetingAudio
  greetingAudio Boolean @default(false) // true = ficheiro carregado pelo cliente, não se regera por TTS
  welcomeAudio Boolean @default(false) // true = há boas-vindas carregadas (custom/ivr_<id>_welcome), tocadas uma vez antes da saudação
  options     Json // [{ digit: "1", destType: "EXTENSION"|"GROUP"|"IVR", destValue }]
  timeoutSecs Int      @default(3) // espera por um dígito depois da saudação
  maxRetries  Int      @default(2) // repetições da saudação antes de desistir
  createdAt   DateTime @default(now())

  @@unique([tenantId, name])
}

// Fatura da subscrição mensal do CRM (produto CRM_BYO_PBX; também qualquer plano com mensalidade)
model Invoice {
  id          String        @id @default(cuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  period      String // "YYYY-MM"
  amountCents Int
  status      InvoiceStatus @default(DUE)
  issuedAt    DateTime      @default(now())
  paidAt      DateTime?
  note        String?

  @@unique([tenantId, period])
  @@index([tenantId, issuedAt])
}

// Registos de chamadas (CDR) sincronizados do PBX próprio do cliente (produto CRM_BYO_PBX)
model PbxCall {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  uid          String // identificador único da chamada no PBX Yeastar
  callType     String // Inbound | Outbound | Internal
  disposition  String // ANSWERED | NO ANSWER | BUSY | FAILED | VOICEMAIL
  fromNumber   String
  toNumber     String
  fromName     String?
  toName       String?
  durationSecs Int      @default(0)
  ringSecs     Int      @default(0)
  talkSecs     Int      @default(0)
  recordFile   String?
  startedAt    DateTime
  syncedAt     DateTime @default(now())

  @@unique([tenantId, uid])
  @@index([tenantId, startedAt])
}

model ApiKey {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  label        String
  keyHash      String    @unique
  prefix       String
  scopes       String[]
  // Origens permitidas (IP ou CIDR, ex.: "102.130.202.155", "10.0.0.0/8").
  // Lista vazia = sem restrição de origem. Ver services/ipAllowlist.ts.
  allowedCidrs String[]  @default([])
  lastUsedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model TenantUser {
  id              String         @id @default(cuid())
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id])
  name            String
  email           String         @unique
  passwordHash    String
  role            TenantRole     @default(MEMBER)
  // Perfil de acesso definido no backoffice. Null = sem restrição além do role.
  accessProfileId String?
  accessProfile   AccessProfile? @relation(fields: [accessProfileId], references: [id], onDelete: SetNull)
  twoFaSecret     String?
  // Extensão do utilizador (agente ou supervisor). É por ela que o supervisor
  // ouve e que se impede supervisionar a própria chamada.
  extensionId     String?        @unique
  extension       Extension?     @relation(fields: [extensionId], references: [id], onDelete: SetNull)
  supervisedGroups SupervisorGroup[]
  lastLoginAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  conversations   Conversation[]
  assignedTickets Ticket[]       @relation("TicketAssignee")
  ticketEvents    TicketEvent[]
}

// Perfil de acesso ao CRM, gerido pela Comunica no backoffice. A matriz diz,
// por funcionalidade (FEATURE_KEYS), se o utilizador não vê, só consulta ou
// pode alterar: { "contacts": "write", "wallet": "read", "team": "none" }.
// Chave em falta = "none". Nunca se aplica a um OWNER.
model AccessProfile {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  name        String
  description String?
  permissions Json
  users       TenantUser[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([tenantId, name])
}

// ============ OPERADOR (COMUNICA) ============

model AdminUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(OPERATOR)
  twoFaSecret  String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// Catálogo comercial gerido no backoffice. O comportamento (faturação,
// telefonia, acesso ao CRM) continua a vir do baseType: um produto novo é um
// nome e uns defaults por cima de um dos três tipos base. Os planos copiam o
// baseType para Plan.productType, que é o que o resto do código lê.
model Product {
  id              String      @id @default(cuid())
  name            String
  description     String?
  baseType        ProductType @default(VOICE_AI)
  aiAgentsEnabled Boolean     @default(true) // defaults sugeridos ao criar um plano
  clinicEnabled   Boolean     @default(false)
  smsEnabled      Boolean     @default(false)
  monthlyFeeCents Int         @default(0)
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  plans           Plan[]
}

model Plan {
  id                       String      @id @default(cuid())
  name                     String
  product                  Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId                String?
  productType              ProductType @default(VOICE_AI) // espelho de product.baseType
  aiAgentsEnabled          Boolean     @default(true) // se o cliente tem agentes de IA
  clinicEnabled            Boolean     @default(false) // acesso ao módulo Clínica
  smsEnabled               Boolean     @default(false) // acesso ao envio de SMS
  pricePerSmsCents         Int         @default(0) // preço por segmento de SMS (default do plano)
  billingMode              BillingMode @default(PER_MINUTE)
  pricePerMinuteCents      Int
  pricePerCallCents        Int         @default(0)
  // Canais de texto: preço por resposta da IA (as do operador não custam).
  // Tabela própria — texto é muito mais barato que voz.
  pricePerTextMessageCents Int         @default(0)
  includedMinutes          Int         @default(0)
  monthlyFeeCents          Int         @default(0)
  maxAgents                Int         @default(1)
  maxConcurrent            Int         @default(1)
  sttMarginPct             Int         @default(30)
  isActive                 Boolean     @default(true)
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt
  tenants                  Tenant[]
}

model SystemSetting {
  key       String   @id
  value     String
  isSecret  Boolean  @default(false)
  updatedBy String?
  updatedAt DateTime @updatedAt
}

// ============ AGENTES DE IA ============

// Como falamos com o modelo do cliente. FALAI_TURN é o nosso contrato nativo
// (o mais simples de implementar do lado dele); os outros dois existem para
// apontar directamente a um modelo servido por vLLM/Ollama/compatível, sem ele
// escrever adaptador nenhum. Ver packages/providers/src/llm/RemoteModelAdapter.ts
enum ModelProtocol {
  FALAI_TURN
  OPENAI_CHAT
  ANTHROPIC_MESSAGES
}

// Modelo de inferência do próprio cliente (produto API_BYOM). Ele treina onde
// quiser; connosco regista só o endereço e as credenciais. Passa pela mesma
// moderação dos agentes: nada entra numa chamada real sem status = ACTIVE.
model TenantModel {
  id            String        @id @default(cuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  name          String
  endpointUrl   String // validado contra SSRF em packages/providers/src/llm/urlGuard.ts
  protocol      ModelProtocol @default(FALAI_TURN)
  modelName     String? // exigido por OPENAI_CHAT / ANTHROPIC_MESSAGES
  authType      String        @default("BEARER") // BEARER | HEADER | NONE
  authSecret    String? // encriptado (AES-256-GCM) via crypto.service
  authHeader    String? // nome do cabeçalho quando authType = HEADER
  timeoutMs     Int           @default(4000)
  maxReplyChars Int           @default(800)
  // Segredo com que assinamos os pedidos que lhe fazemos (HMAC), para ele
  // confirmar que o pedido vem mesmo de nós. Encriptado.
  signingSecret String?
  status        AgentStatus   @default(DRAFT)
  approvedBy    String?
  lastHealthAt  DateTime?
  lastLatencyMs Int?
  lastError     String?
  // Respostas recusadas pelos guardrails. Ao fim de GUARDRAIL_AUTO_BLOCK o
  // modelo é bloqueado sozinho — ver services/guardrail.service.ts
  violations    Int           @default(0)
  deletedAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  agents        Agent[]

  @@index([tenantId])
}

model Agent {
  id               String         @id @default(cuid())
  tenantId         String
  tenant           Tenant         @relation(fields: [tenantId], references: [id])
  name             String
  description      String?
  systemPrompt     String         @db.Text
  language         String         @default("pt-PT")
  ttsVoiceId       String? // null = agente só de texto (canais de texto); chamadas de voz exigem-no
  sttModel         String         @default("default")
  maxTurnSeconds   Int            @default(30)
  maxCallSeconds   Int            @default(300)
  escalationNumber String?
  escalationRules  Json?
  variablesSchema  Json?
  greetingAudioRef String?
  isApproved       Boolean        @default(false)
  approvedBy       String?
  status           AgentStatus    @default(DRAFT)
  // Modelo do cliente a usar neste agente. Null = motor da plataforma (Claude).
  modelId          String?
  model            TenantModel?   @relation(fields: [modelId], references: [id])
  deletedAt        DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  calls            Call[]
  versions         AgentVersion[]
  campaigns        Campaign[]
  inboxes          Inbox[]
}

model AgentVersion {
  id           String   @id @default(cuid())
  agentId      String
  agent        Agent    @relation(fields: [agentId], references: [id])
  systemPrompt String   @db.Text
  changedBy    String
  createdAt    DateTime @default(now())
}

// ============ CHAMADAS ============

model Call {
  id                String     @id @default(cuid())
  tenantId          String
  tenant            Tenant     @relation(fields: [tenantId], references: [id])
  agentId           String?
  agent             Agent?     @relation(fields: [agentId], references: [id])
  kind              CallKind   @default(AI_AGENT)
  campaignId        String?
  campaign          Campaign?  @relation(fields: [campaignId], references: [id])
  contactId         String?
  contact           Contact?   @relation(fields: [contactId], references: [id])
  toNumber          String
  fromNumber        String? // origem — preenchido em chamadas de entrada (kind INBOUND)
  variables         Json?
  status            CallStatus @default(QUEUED)
  outcome           String?
  yeastarCallId     String?    @unique
  startedAt         DateTime?
  answeredAt        DateTime?
  endedAt           DateTime?
  durationSecs      Int        @default(0)
  billedSecs        Int        @default(0)
  costCents         Int        @default(0)
  providerCostCents Int        @default(0)
  transcript        Json?
  summary           String?    @db.Text
  // Caminho do ficheiro de gravação RELATIVO à pasta de gravações (ver
  // RECORDING_DIR). Nunca é servido directamente ao browser: a rota
  // /tenant/calls/:id/recording é que lê o ficheiro, já com o tenant validado.
  recordingUrl      String?
  failReason        String?
  webhookDelivered  Boolean    @default(false)
  // Chamadas de entrada: quando começou a tocar em extensões (fim do IVR) e
  // por que grupo. Base do tempo de espera nos relatórios de atendimento.
  queuedAt          DateTime?
  groupId           String?
  group             ExtensionGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  turns             CallTurn[]
  legs              CallLeg[]
  notes             ContactNote[]
  // Ticket a que a chamada pertence (um ticket junta várias interacções).
  ticketId          String?
  ticket            Ticket?    @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([tenantId, kind, startedAt])
  @@index([tenantId, contactId, startedAt]) // histórico do cliente (screen pop)
  @@index([ticketId])
}

enum CallLegOutcome {
  ANSWERED
  NO_ANSWER // tocou até ao timeout
  REJECTED // o agente recusou (SIP 603 / causa 21)
  BUSY // 486: em chamada ou "não incomodar"
  CANCELLED // outra perna atendeu, ou quem ligou desligou primeiro
  FAILED // não chegou a tocar (extensão offline)
}

// Uma tentativa de entregar uma chamada de entrada a uma extensão (agente).
// Uma por extensão, mesmo tocando em hardphone e webphone ao mesmo tempo.
// É a base dos KPIs por agente e por grupo (relatórios de atendimento).
model CallLeg {
  id              String          @id @default(cuid())
  tenantId        String
  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  callId          String
  call            Call            @relation(fields: [callId], references: [id], onDelete: Cascade)
  extensionId     String?
  extension       Extension?      @relation(fields: [extensionId], references: [id], onDelete: SetNull)
  extensionNumber String // cópia: o relatório sobrevive a uma extensão apagada
  groupId         String? // grupo pelo qual tocou (null = destino directo)
  group           ExtensionGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  ringStartedAt   DateTime
  answeredAt      DateTime?
  endedAt         DateTime?
  outcome         CallLegOutcome?
  hangupCause     Int?
  rejectReasonId  String?
  rejectReason    RejectReason?   @relation(fields: [rejectReasonId], references: [id], onDelete: SetNull)
  rejectNote      String? // texto livre da opção "Outro"
  // Tipificação (só na perna que atendeu). wrapUpEndsAt = até quando o agente
  // fica indisponível à espera de tipificar (null = tipificação opcional).
  categoryId      String?
  category        CallCategory?   @relation("LegCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  subcategoryId   String?
  subcategory     CallCategory?   @relation("LegSubcategory", fields: [subcategoryId], references: [id], onDelete: SetNull)
  typingNote      String?
  typedAt         DateTime?
  typedById       String? // TenantUser que tipificou por último (histórico em AuditLog)
  wrapUpEndsAt    DateTime?

  @@index([tenantId, ringStartedAt])
  @@index([tenantId, extensionId, ringStartedAt])
  @@index([tenantId, groupId, ringStartedAt])
  @@index([callId])
  @@index([extensionId, wrapUpEndsAt])
}

// Tipificação de chamadas em 2 níveis: categoria (parentId null) → subcategoria.
// Desactiva-se em vez de apagar, para o histórico continuar a ter o nome.
model CallCategory {
  id        String              @id @default(cuid())
  tenantId  String
  tenant    Tenant              @relation(fields: [tenantId], references: [id])
  parentId  String?
  parent    CallCategory?       @relation("CallCategoryTree", fields: [parentId], references: [id])
  children  CallCategory[]      @relation("CallCategoryTree")
  name      String
  isActive  Boolean             @default(true)
  sortOrder Int                 @default(0)
  // Só nas categorias: grupos que a podem usar. Vazio = todos.
  groups    CallCategoryGroup[]
  legs      CallLeg[]           @relation("LegCategory")
  subLegs   CallLeg[]           @relation("LegSubcategory")
  tickets    Ticket[]           @relation("TicketCategory")
  subTickets Ticket[]           @relation("TicketSubcategory")
  createdAt DateTime            @default(now())

  @@index([tenantId])
}

// Grupos que um supervisor supervisiona. OWNER/ADMIN supervisionam todos.
model SupervisorGroup {
  tenantUserId String
  groupId      String
  user         TenantUser     @relation(fields: [tenantUserId], references: [id], onDelete: Cascade)
  group        ExtensionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([tenantUserId, groupId])
}

enum SupervisionEventType {
  START
  MODE
  END
}

enum SupervisionMode {
  LISTEN // supervisor ouve
  WHISPER // supervisor ouve e fala só para o agente
  BARGE // supervisor entra na conversa
}

// Registo de supervisões — IMUTÁVEL: um trigger na BD recusa UPDATE e DELETE
// (ver a migração). Uma supervisão = eventos com o mesmo sessionId.
model SupervisionEvent {
  id               String               @id @default(cuid())
  tenantId         String
  tenant           Tenant               @relation(fields: [tenantId], references: [id])
  sessionId        String
  type             SupervisionEventType
  mode             SupervisionMode?
  supervisorId     String // TenantUser
  agentExtensionId String?
  agentExtension   String? // número, cópia para o registo sobreviver
  callId           String
  contactId        String?
  endReason        String? // SUPERVISOR | CALL_ENDED | SUPERVISOR_HUNGUP | ERROR
  at               DateTime             @default(now())

  @@index([tenantId, at])
  @@index([sessionId])
}

model CallCategoryGroup {
  categoryId String
  groupId    String
  category   CallCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  group      ExtensionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([categoryId, groupId])
}

// Motivos de recusa de chamadas, configuráveis por tenant. A opção "Outro"
// (texto livre) é fixa na UI e grava em CallLeg.rejectNote.
model RejectReason {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  label     String
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  legs      CallLeg[]

  @@unique([tenantId, label])
}

model CallTurn {
  id             String   @id @default(cuid())
  callId         String
  call           Call     @relation(fields: [callId], references: [id])
  seq            Int
  role           TurnRole
  text           String   @db.Text
  audioRef       String?
  sttMs          Int?
  llmMs          Int?
  ttsMs          Int?
  playMs         Int?
  // Que modelo respondeu neste turno. Null = motor da plataforma. Guardado
  // turno a turno para se poder responsabilizar uma resposta concreta.
  modelId        String?
  // Guardrails que este turno violou, se algum (ex.: ["reply_too_long"]).
  // Null = passou limpo. Ver services/guardrail.service.ts
  guardrailFlags Json?
  createdAt      DateTime @default(now())

  @@unique([callId, seq])
}

// ============ CAMPANHAS & CONTACTOS ============

model Campaign {
  id                String            @id @default(cuid())
  tenantId          String
  tenant            Tenant            @relation(fields: [tenantId], references: [id])
  agentId           String?
  agent             Agent?            @relation(fields: [agentId], references: [id])
  mode              CampaignMode      @default(VOICE_AI)
  scriptText        String?           @db.Text
  ttsVoiceId        String?
  name              String
  status            CampaignStatus    @default(DRAFT)
  scheduleJson      Json?
  retryPolicy       Json?
  throttlePerMinute Int               @default(2)
  totalContacts     Int               @default(0)
  completed         Int               @default(0)
  failedCount       Int               @default(0)
  summary           String?           @db.Text
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  calls             Call[]
  campaignContacts  CampaignContact[]
}

model Contact {
  id               String            @id @default(cuid())
  tenantId         String
  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  // Opcional desde os canais de texto: um visitante do widget ou um contacto
  // de Telegram não tem telefone. Postgres aceita vários NULL no @@unique.
  phone            String?
  // ponytail: uma coluna por identidade em vez de tabela ContactIdentity.
  // Migrar para tabela quando entrar o 4º canal.
  email            String?
  telegramId       String?
  name             String?
  attributes       Json?
  optedOutAt       DateTime?
  optOutReason     String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  calls            Call[]
  campaignContacts CampaignContact[]
  smsMessages      SmsMessage[]
  conversations    Conversation[]
  // Histórico do cliente na entrada (melhoria 3)
  phones           ContactPhone[]
  notes            ContactNote[]
  tickets          Ticket[]

  @@unique([tenantId, phone])
  @@unique([tenantId, email])
  @@unique([tenantId, telegramId])
  // Pesquisa por parte do nome/número (perfil do cliente, melhoria 5)
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Contact_name_trgm_idx")
  @@index([phone(ops: raw("gin_trgm_ops"))], type: Gin, map: "Contact_phone_trgm_idx")
}

// Números extra de um contacto (o principal continua em Contact.phone), no
// mesmo formato nacional de 9 dígitos. Um número só pode pertencer a um
// contacto do tenant — verificado no código, porque são duas tabelas.
model ContactPhone {
  id        String   @id @default(cuid())
  tenantId  String
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  phone     String
  label     String?
  createdAt DateTime @default(now())

  @@unique([tenantId, phone])
  @@index([contactId])
}

// Notas do agente sobre o cliente, opcionalmente ligadas à chamada em curso.
model ContactNote {
  id        String   @id @default(cuid())
  tenantId  String
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  callId    String?
  call      Call?    @relation(fields: [callId], references: [id], onDelete: SetNull)
  authorId  String // TenantUser
  body      String   @db.Text
  createdAt DateTime @default(now())

  @@index([tenantId, contactId, createdAt])
}

// ============ SMS ============

// Mensagem SMS enviada por um cliente através do gateway Futurix.
model SmsMessage {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  contactId     String?
  contact       Contact?     @relation(fields: [contactId], references: [id])
  campaignId    String? // SmsCampaign (envio em massa); null = envio avulso
  campaign      SmsCampaign? @relation(fields: [campaignId], references: [id])
  toNumber      String
  body          String       @db.Text
  segments      Int          @default(1) // nº de segmentos faturados (160 GSM / 70 unicode)
  status        SmsStatus    @default(QUEUED)
  costCents     Int          @default(0)
  senderId      String? // remetente usado (snapshot do Tenant.smsSenderId)
  providerMsgId String? // id da mensagem no gateway (para delivery report)
  // O que originou a mensagem. Null = envio manual ou campanha. "MISSED_CALL" =
  // automático por chamada não atendida — é por aqui que o travão de um SMS por
  // número por dia conta só os automáticos, sem ser enganado por um envio manual.
  trigger       String?
  failReason    String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([tenantId, createdAt])
  @@index([providerMsgId])
  // Serve o travão de um SMS automático por número por dia.
  @@index([tenantId, toNumber, trigger, createdAt])
}

// Campanha de SMS em massa (espelha as campanhas de voz, mas para SMS).
model SmsCampaign {
  id                String         @id @default(cuid())
  tenantId          String
  tenant            Tenant         @relation(fields: [tenantId], references: [id])
  name              String
  body              String         @db.Text // template da mensagem (suporta {variáveis})
  status            CampaignStatus @default(DRAFT)
  totalRecipients   Int            @default(0)
  sentCount         Int            @default(0)
  failedCount       Int            @default(0)
  costCents         Int            @default(0)
  throttlePerMinute Int            @default(60)
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  messages          SmsMessage[]

  @@index([tenantId, createdAt])
}

model CampaignContact {
  id          String                @id @default(cuid())
  campaignId  String
  campaign    Campaign              @relation(fields: [campaignId], references: [id])
  contactId   String
  contact     Contact               @relation(fields: [contactId], references: [id])
  status      CampaignContactStatus @default(PENDING)
  callId      String?
  attempts    Int                   @default(0)
  nextRetryAt DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@unique([campaignId, contactId])
  @@index([campaignId, status])
}

// ============ FINANCEIRO ============

model WalletTransaction {
  id                String   @id @default(cuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  type              TxType
  amountCents       Int
  balanceAfterCents Int
  reference         String?
  proxypayRef       String?  @unique
  note              String?
  createdBy         String?
  createdAt         DateTime @default(now())
}

// Compras de saldo junto do fornecedor (ex.: crédito de voz/telefonia). Serve
// para controlar quanto resta do saldo comprado, descontando o custo
// acumulado em Call.providerCostCents (ver billing.service.ts).
model ProviderTopUp {
  id          String   @id @default(cuid())
  amountCents Int
  note        String?
  createdBy   String?
  createdAt   DateTime @default(now())
}

// ============ AUDITORIA & SAÚDE ============

model AuditLog {
  id         String   @id @default(cuid())
  actorType  String
  actorId    String
  tenantId   String?
  action     String
  targetType String
  targetId   String
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now())
}

model SystemEvent {
  id        String   @id @default(cuid())
  severity  String
  source    String
  tenantId  String?
  message   String
  payload   Json?
  createdAt DateTime @default(now())

  @@index([tenantId])
}

// ── Canais de texto (chat, email, Telegram) ─────────────────────────────────
// Ver docs/PLANO-CANAIS-TEXTO.md. O motor de IA é o mesmo da voz
// (processTextTurn em services/TurnProcessor.ts); o que muda é o transporte.

enum Channel {
  WEBCHAT
  EMAIL
  TELEGRAM
  WHATSAPP // WhatsApp Business Cloud API (Meta)
}

// Pool Active/Standby do link público /public/wa/:tenantId.
// Ver docs/WHATSAPP-ACTIVE-STANDBY.md.
enum WaPoolStatus {
  ACTIVE // recebe os cliques do botão
  DEGRADED // em serviço, com erros abaixo do limiar
  STANDBY
  FAILED // confirmado indisponível; só volta por acção manual
  DISABLED // retirado do pool pelo admin
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
}

enum ConversationMode {
  AI
  HUMAN
}

model Inbox {
  id            String         @id @default(cuid())
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  channel       Channel
  name          String
  // Agente que responde. Null = só humanos.
  agentId       String?
  agent         Agent?         @relation(fields: [agentId], references: [id])
  // Configuração do canal. Segredos (ex.: botToken) cifrados via crypto.service.
  config        Json
  // Segredo que o canal apresenta ao chamar o nosso webhook.
  webhookSecret String
  autoReply     Boolean        @default(true)
  enabled       Boolean        @default(true)
  // Só WHATSAPP. Um só ACTIVE/DEGRADED por tenant (índice parcial na migração).
  waStatus      WaPoolStatus?
  waPriority    Int?
  waFailCount   Int            @default(0)
  waLastCheckAt DateTime?
  waLastError   String?
  waStatusAt    DateTime?
  deletedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  conversations Conversation[]

  @@index([tenantId])
}

model Conversation {
  id            String             @id @default(cuid())
  tenantId      String
  tenant        Tenant             @relation(fields: [tenantId], references: [id])
  inboxId       String
  inbox         Inbox              @relation(fields: [inboxId], references: [id])
  contactId     String?
  contact       Contact?           @relation(fields: [contactId], references: [id])
  assigneeId    String?
  assignee      TenantUser?        @relation(fields: [assigneeId], references: [id])
  status        ConversationStatus @default(OPEN)
  mode          ConversationMode   @default(AI)
  subject       String?
  // Identificador do outro lado no canal (chat.id do Telegram, token do
  // widget, Message-ID raiz do email).
  externalRef   String
  // Contador atómico que dá o seq das mensagens sem corrida.
  messageCount  Int                @default(0)
  lastMessageAt DateTime           @default(now())
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  messages      Message[]
  // Ticket a que a conversa pertence (um ticket junta várias interacções).
  ticketId      String?
  ticket        Ticket?            @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, lastMessageAt])
  @@index([inboxId, externalRef])
  @@index([ticketId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  seq            Int
  // HUMAN = cliente final; AGENT = IA ou operador (authorId preenchido).
  role           TurnRole
  text           String       @db.Text
  attachments    Json?
  // Operador do CRM que escreveu. Null = cliente final ou IA.
  authorId       String?
  externalId     String?
  llmMs          Int?
  modelId        String?
  guardrailFlags Json?
  costCents      Int          @default(0)
  createdAt      DateTime     @default(now())

  @@unique([conversationId, seq])
}

// Resposta rápida do operador no CRM: escreve "/atalho" e o texto é inserido.
model CannedResponse {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  shortcut  String
  text      String   @db.Text
  createdAt DateTime @default(now())

  @@unique([tenantId, shortcut])
}

// ============ ANÁLISE DOS RELATÓRIOS COM IA (melhoria 6) ============

// Uma análise por pedido. Cache: mesmos filtros (filtersKey) e mesmos dados
// agregados (dataHash) devolvem a análise já feita, sem nova chamada à IA.
model ReportAnalysis {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  filters       Json // período + agente/grupo/tipificação, como pedidos
  filtersKey    String
  dataHash      String // hash do resumo agregado enviado à IA
  promptVersion String
  model         String
  result        Json? // análise validada (null se falhou)
  error         String?
  inputTokens   Int      @default(0)
  outputTokens  Int      @default(0)
  costMicroUsd  Int      @default(0) // 1 USD = 1 000 000
  durationMs    Int?
  requestedById String? // TenantUser
  createdAt     DateTime @default(now())

  @@index([tenantId, filtersKey, createdAt])
  @@index([tenantId, createdAt])
}

// ============ TICKETS (centro de atendimento) ============
// Ver docs/PLANO-CENTRO-ATENDIMENTO.md. Um só modelo para os dois modos: nos
// tenants com helpdesk externo (Freshdesk) a linha é espelho e leva
// externalSystem/externalId; nos outros vive só aqui.

enum TicketStatus {
  OPEN
  PENDING // à espera do cliente
  ON_HOLD // à espera de terceiros / outra equipa
  RESOLVED // pode ser reaberto
  CLOSED // final
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketEventType {
  CREATED
  STATUS
  PRIORITY
  LEVEL
  ASSIGNEE
  GROUP
  CATEGORY
  SUBJECT
  NOTE
  LINKED // chamada ou conversa associada
  UNLINKED
}

model Ticket {
  id             String          @id @default(cuid())
  tenantId       String
  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  number         Int // sequencial por tenant (Tenant.ticketSeq)
  subject        String
  description    String?         @db.Text
  status         TicketStatus    @default(OPEN)
  priority       TicketPriority  @default(MEDIUM)
  supportLevel   Int             @default(1) // 1º, 2º ou 3º nível
  categoryId     String?
  category       CallCategory?   @relation("TicketCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  subcategoryId  String?
  subcategory    CallCategory?   @relation("TicketSubcategory", fields: [subcategoryId], references: [id], onDelete: SetNull)
  contactId      String?
  contact        Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  assigneeId     String?
  assignee       TenantUser?     @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  groupId        String? // equipa responsável
  group          ExtensionGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  source         String          @default("MANUAL") // MANUAL | CALL | WHATSAPP | WEB | EMAIL | TELEGRAM | API
  dueAt          DateTime?
  resolvedAt     DateTime?
  closedAt       DateTime?
  reopenCount    Int             @default(0)
  externalSystem String? // "FRESHDESK" quando é espelho
  externalId     String?
  createdById    String? // TenantUser (null = API/sistema)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  events         TicketEvent[]
  calls          Call[]
  conversations  Conversation[]

  @@unique([tenantId, number])
  @@unique([tenantId, externalSystem, externalId])
  @@index([tenantId, status, updatedAt])
  @@index([tenantId, assigneeId, status])
  @@index([tenantId, contactId])
}

// Linha do tempo do ticket: alterações (from → to) e notas internas.
model TicketEvent {
  id        String          @id @default(cuid())
  ticketId  String
  ticket    Ticket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  type      TicketEventType
  fromValue String?
  toValue   String?
  body      String?         @db.Text // nota
  authorId  String? // null = API/sistema
  author    TenantUser?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime        @default(now())

  @@index([ticketId, createdAt])
}

// ============ ALERTAS OPERACIONAIS (centro de atendimento, fase 4) ============
// Ver services/alerts.service.ts. Um alerta abre quando um limite é passado e
// fecha quando deixa de o estar; o histórico é o relatório de desvios.

enum AlertType {
  LONG_WAIT // chamada em espera há mais de maxWaitSecs
  LONG_HANDLE // chamada em curso há mais de maxHandleSecs
  NO_AGENTS // grupo com menos agentes disponíveis do que minAvailableAgents
  SLA_BELOW // SLA do dia abaixo da meta
  ABANDON_ABOVE // taxa de abandono do dia acima do limite
  TMA_ABOVE // TMA do dia acima do limite
}

model Alert {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  type      AlertType
  ref       String // callId, groupId ou o dia (AAAA-MM-DD), conforme o tipo
  groupId   String?
  value     Float // valor quando abriu (segundos, % ou nº de agentes)
  threshold Float
  endValue  Float?
  // Preenchido enquanto está aberto: impede duplicados mesmo com várias
  // instâncias da API (o Postgres aceita vários NULL no unique).
  openKey   String?   @unique
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  @@index([tenantId, startedAt])
  @@index([tenantId, endedAt])
}
